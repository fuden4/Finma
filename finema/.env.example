# Local dev (npm run dev on your machine)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sandbox_db
SESSION_SECRET=your-random-32-plus-character-secret-here
# Local dev on Windows only (omit in Docker — the image includes ffmpeg)
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
#
# GIF search in comments (free key from https://developers.giphy.com/dashboard/)
GIPHY_API_KEY=your-giphy-api-key-here

# Docker (docker-compose sets DATABASE_URL for the app container)
# POSTGRES_PASSWORD=postgres
# POSTGRES_PORT=5433
# APP_PORT=3000
# SESSION_COOKIE_SECURE=false   # use false for http:// (LAN). set true behind HTTPS.
# GIPHY_API_KEY=your-giphy-api-key-here
#
# Server (production):
#   echo 'SESSION_SECRET=your-32-plus-char-secret' > .env
#   docker compose up -d --build
#   docker compose exec app npm run db:migrate
#
# Local dev with hot reload:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build
